# social-video-agent needs no configuration. The default transcription backend
# runs locally, offline, with no account and no API key.
#
# These are read from the *environment*. The project does not parse this file
# itself -- copy the lines you want into your shell profile, or use a tool such
# as direnv. (Upstream video-use parses a .env from the current directory,
# which silently shadows a real environment variable; we would rather not have
# that ambiguity.)

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# Which backend to use: faster-whisper (default) or whisperx (needs the
# [align] extra). CLI --backend takes precedence.
# SOCIAL_VIDEO_TRANSCRIBER=faster-whisper

# ---------------------------------------------------------------------------
# Hardware
# ---------------------------------------------------------------------------
# Skip the GPU attempt entirely. Useful when a CUDA device is visible but its
# cuBLAS/cuDNN do not match the installed CTranslate2 -- transcription already
# falls back to CPU on its own, this just avoids the failed attempt.
# SOCIAL_VIDEO_FORCE_CPU=1

# Remotion: how many browser tabs render frames at once, as a count or a share
# of the cores. Unset keeps Remotion's default; lower it when memory is tight.
# SOCIAL_VIDEO_REMOTION_CONCURRENCY=50%

# Remotion: the OpenGL backend Chrome draws with. "angle" can move blur and
# shadows to the GPU; unset keeps Remotion's software default.
# SOCIAL_VIDEO_REMOTION_GL=angle

# Remotion: where the built compositor is kept between renders (about 40 MB
# each, the three most recent). It is rebuilt whenever the compositions, the
# lockfile or a reel's custom components change. Set a directory to move it,
# or "off" to build one per render.
# SOCIAL_VIDEO_REMOTION_BUNDLE_CACHE=off

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where downloaded models and any bootstrapped ffmpeg are cached.
# Defaults to the platform cache directory.
# SOCIAL_VIDEO_HOME=/path/to/cache

# Point at a specific ffmpeg build instead of the one on PATH.
# SOCIAL_VIDEO_FFMPEG=/usr/local/bin/ffmpeg
# SOCIAL_VIDEO_FFPROBE=/usr/local/bin/ffprobe

# Use a face-detection model file you already have instead of downloading
# YuNet once into the cache (needed for speaker framing, not for --reframe
# center).
# SOCIAL_VIDEO_YUNET_MODEL=/path/to/face_detection_yunet_2023mar.onnx

# Where the local render log is kept (sizes, durations and timings only; no
# paths or text). It feeds the render time estimate. "off" disables it.
# SOCIAL_VIDEO_RENDER_LOG=off

# ---------------------------------------------------------------------------
# Windows agent, engine in WSL2 (hybrid)
# ---------------------------------------------------------------------------
# Which runtime to use instead of detecting it, and which WSL distribution
# holds the engine. A project config may pin both; the environment wins.
# SOCIAL_VIDEO_RUNTIME_MODE=windows-agent-wsl-runtime
# SOCIAL_VIDEO_WSL_DISTRIBUTION=Ubuntu

# A Linux path to the engine inside the distribution, when it is not in
# ~/.local/bin, /usr/local/bin or /usr/bin.
# SOCIAL_VIDEO_WSL_ENGINE=/opt/social-video-agent/bin/social-video-agent

# Set to "windows" by scripts/windows/social-video-agent.ps1 and shared into
# WSL, so the engine knows the agent is on the Windows side. Not set by hand.
# SOCIAL_VIDEO_AGENT_PLATFORM=windows

# ---------------------------------------------------------------------------
# Cloud image generation (backgrounds only; consent-gated)
# ---------------------------------------------------------------------------
# Which API to call when more than one key is present (openai_api or
# gemini_api), or "none" to switch the feature off. The model overrides the
# provider's default. Keys are the providers' own variables: OPENAI_API_KEY,
# GEMINI_API_KEY or GOOGLE_API_KEY.
# SOCIAL_VIDEO_IMAGE_PROVIDER=none
# SOCIAL_VIDEO_IMAGE_MODEL=

# ---------------------------------------------------------------------------
# MCP server (`social-video-agent mcp serve`)
# ---------------------------------------------------------------------------
# Seconds one tool call may run before the server reports a timeout instead of
# waiting. The default, six hours, is above the longest render.
# SOCIAL_VIDEO_MCP_TIMEOUT=21600

# ---------------------------------------------------------------------------
# Speaker diarization (`transcribe --diarize`, the `diarize` extra)
# ---------------------------------------------------------------------------
# Your own Hugging Face read token, after accepting the conditions of
# pyannote/speaker-diarization-community-1. The weights are gated and cannot be
# redistributed, so there is no shared default. Audio never leaves the machine.
# HF_TOKEN=hf_...
