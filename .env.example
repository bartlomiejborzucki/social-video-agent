# social-video-agent works fully offline with the default local transcription
# backend (faster-whisper). Nothing here is required.

# ---------------------------------------------------------------------------
# Optional cloud transcription. Setting these UPLOADS YOUR AUDIO to a third
# party. The default backend does not.
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Optional speaker diarization via pyannote.
# You must first accept the model conditions on Hugging Face for
# `pyannote/speaker-diarization-community-1` with your own account, then create
# a read token. We cannot ship one for you.
# ---------------------------------------------------------------------------
# HUGGINGFACE_TOKEN=

# ---------------------------------------------------------------------------
# Backend selection (CLI flags take precedence).
# ---------------------------------------------------------------------------
# SOCIAL_VIDEO_TRANSCRIBER=faster-whisper
# SOCIAL_VIDEO_WHISPER_MODEL=small
